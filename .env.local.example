# Copy this file to .env.local and fill in your real values.
# .env.local is gitignored — your secrets never get committed.

# ---- Database ----
# Postgres connection string. The default matches the docker-compose.yml
# service (`docker compose up -d`). In production, point this at your Neon /
# Supabase / RDS instance. The store's tables live in their own Postgres
# schema, `store`, so this can safely be a database that holds other things.
DATABASE_URL=postgresql://store:store@localhost:5432/store

# Only for hosts whose certificates are signed by a private CA (Supabase is
# one). Paste the PEM in double quotes; leave it empty for local Docker.
# Supabase: Settings → Database → SSL → "Download certificate".
# Do NOT also put sslmode= in DATABASE_URL when this is set.
DATABASE_CA_CERT=""

# ---- Admin auth ----
# Secret used to sign admin session tokens (HS256). Generate a strong one:
#   openssl rand -base64 32
# Rotating it signs everyone out.
JWT_SECRET=replace-me-with-openssl-rand-base64-32

# First admin account, created by `npm run db:seed` (only if the email is new).
# Change the password after your first sign-in, or set a strong one here.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=changeme123

# ---- Stripe ----
# From Stripe Dashboard -> Developers -> API keys (use TEST keys while developing)
STRIPE_SECRET_KEY=sk_test_xxx

# From Stripe Dashboard -> Developers -> Webhooks -> your endpoint signing secret
# (only needed once you set up the /api/webhook endpoint)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ---- Site ----
# Public base URL of your site. Used for Stripe success/cancel redirects AND
# for SEO: canonical link, Open Graph / Twitter share URLs, and the absolute
# image URLs in the Product structured data. Set this in production or shared
# links and search snippets will point at localhost.
# Local dev:
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Production: set this to your real domain, e.g. https://yourstore.com
